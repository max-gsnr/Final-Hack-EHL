signals from the workbook: Mercedes E-Class and Audi A6 reports and equipment lists, each linked to its row and original source.', zoom: true },","+  '06c-move-up': { chapter: 'demo1', title: 'Back to the ranking', text: 'The PM has seen the evidence. Now they decide.', label: 'Move up' },","   '07-moved': { chapter: 'demo1', title: 'The PM decides the order', text: 'Seating comfort moves to #1. The AI proposes; the PM decides.', label: 'Approve' },","   '08-approve': { chapter: 'demo1', title: 'One sentence on why', text: 'The reason is saved with the decision in Decision Memory.', label: 'Approve requirement', zoom: true },","   '09-approved': { chapter: 'demo1', title: 'Approved, with its reason', text: 'This is what the challenge asked for.' },"]},{"oldStart":26,"oldLines":24,"newStart":29,"newLines":25,"lines":["   '14-setup-again': { chapter: 'demo2', title: 'The new PM sets their own constraints', text: '24 months, 8 people, deadline priority 5/10. Same vehicle, same market.' },","   '14b-generate-again': { chapter: 'demo2', title: 'Generate again', text: 'Nothing new uploaded. Decision Memory travels with the project.', label: 'Generate requirements' },","   '15-requirements-again': { chapter: 'demo2', title: 'Seating comfort leads, tagged Past decision', text: 'The new PM sees immediately that this requirement already has history.', label: 'Evidence & reasoning' },","-  '16-memory': { chapter: 'demo2', title: 'The previous PM’s reasoning is part of the ranking', text: 'Decision Memory shows who approved it, when, and why. It adds 5 points: without them, seating comfort would tie for #1.', zoom: true }","+  '16-memory': { chapter: 'demo2', title: 'The previous PM’s reasoning, on the requirement', text: 'Decision Memory shows who approved it, when, and why. No upload, no search: it travels with the project.', zoom: true },","+  '16b-score': { chapter: 'demo2', title: 'And it carries weight in the ranking', text: 'Past decisions are now part of the score, next to customer demand, timeline fit, market evidence and competitor data.', zoom: true }"," };"," "," const QUOTE = 'When I join a project during a handover, I have zero context on what was decided before, or why. I’d love to see the project’s past decisions and the reasons behind them.';"," "," const steps = [","-  { type: 'slide', chapter: 'intro', kind: 'title', html: `<p class=\"kicker-line\">BMW Product Intelligence</p><h1 class=\"display\">From thousands of customer voices<br>to requirements a PM can defend.</h1><p class=\"lede\">A clickable walkthrough of the live demo. Click the highlighted control, or press <kbd>→</kbd>.</p><button class=\"start\" data-next>Start the demo <span aria-hidden=\"true\">→</span></button>` },","-  ...['01-setup', '02-evidence', '03-preview', '04-generate', '05-requirements', '06-reasoning', '07-moved', '08-approve', '09-approved'].map(name => ({ type: 'shot', name })),","+  { type: 'slide', chapter: 'intro', kind: 'title', html: `<p class=\"kicker-line\">BMW Product Intelligence</p><h1 class=\"display\">From thousands of customer voices<br>to requirements a PM can defend.</h1><p class=\"lede\">A recorded, clickable walkthrough of the live demo. Click the highlighted control, or press <kbd>→</kbd>.</p><button class=\"start\" data-next>Start the demo <span aria-hidden=\"true\">→</span></button>` },","+  ...['01-setup', '02-evidence', '03-preview', '04-generate', '05-requirements', '06-reasoning', '06b-competitors', '06c-move-up', '07-moved', '08-approve', '09-approved'].map(name => ({ type: 'shot', name })),","   { type: 'slide', chapter: 'gap', kind: 'scope', html: `<p class=\"kicker-line\">The challenge</p><h2 class=\"display\">That was the brief.<br>And what every team built.</h2><ol class=\"scope-list\"><li><span>01</span>Upfront requirements</li><li><span>02</span>Evidence in</li><li><span>03</span>Ranked requirements with reasoning</li><li><span>04</span>PM decides</li></ol><p class=\"lede\">So we went back and talked to product managers.</p>` },","   { type: 'slide', chapter: 'gap', kind: 'quote', html: `<blockquote class=\"quote\">${QUOTE.split(' ').map((word, i) => `<span style=\"--i:${i}\">${word}</span>`).join(' ')}</blockquote><p class=\"attribution\"><strong>Former Product Manager, Vodafone</strong><span>Quoted with his consent</span></p>` },","   { type: 'slide', chapter: 'demo2', kind: 'divider', html: `<p class=\"kicker-line\">Demo 2</p><h2 class=\"display\">A handover.<br>The new PM starts with the memory, not from zero.</h2>` },","-  ...['10-diary', '11-storyline-menu', '12-storyline-range', '13-storyline', '14-setup-again', '14b-generate-again', '15-requirements-again', '16-memory'].map(name => ({ type: 'shot', name })),","+  ...['10-diary', '11-storyline-menu', '12-storyline-range', '13-storyline', '14-setup-again', '14b-generate-again', '15-requirements-again', '16-memory', '16b-score'].map(name => ({ type: 'shot', name })),","   { type: 'slide', chapter: 'close', kind: 'close', html: `<p class=\"kicker-line\">Product Intelligence</p><h2 class=\"display\">Vehicle projects run for years.<br>PMs change. Decisions shouldn’t get lost.</h2><ul class=\"pillars\"><li><strong>Decision memory</strong><span>Every approval and rejection keeps its reason, and the reason counts in the next ranking.</span></li><li><strong>Onboarding</strong><span>A new PM reads the project’s story before the first meeting.</span></li><li><strong>Handover</strong><span>The next cycle starts where the last one left off.</span></li></ul><p class=\"lede\">We don’t replace product managers. We give them the memory of everyone who came before.</p>` }"," ].map(step => {","   if (step.type !== 'shot') return step;","   const rec = recorded[step.name], copy = SHOT_COPY[step.name];","   if (!rec) throw new Error(`Missing capture for ${step.name}`);","-  return { type: 'shot', chapter: copy.chapter, title: copy.title, text: copy.text, label: copy.label || '', src: image(step.name), hotspot: copy.label ? rec.hotspot : null, focus: copy.zoom ? rec.focus : null };","+  return { type: 'shot', chapter: copy.chapter, title: copy.title, text: copy.text, label: copy.label || '', clip: `media/${rec.clip}`, poster: `media/${rec.poster}`, hotspot: copy.label ? rec.hotspot : null, focus: copy.zoom ? rec.focus : null };"," });"," "," const CHAPTERS = [['intro', 'Intro'], ['demo1', 'Demo 1 · The brief'], ['gap', 'What PMs told us'], ['demo2', 'Demo 2 · Memory'], ['close', 'Close']];"]},{"oldStart":94,"oldLines":8,"newStart":98,"newLines":12,"lines":[" #shot-stage{grid-template-rows:1fr auto;justify-items:center;padding:22px 32px 0}"," .frame{position:relative;width:min(100%,calc((100vh - 64px - 22px - 150px) * 1.6));aspect-ratio:16/10;align-self:center;overflow:hidden;background:#fff;border:1px solid var(--line);box-shadow:0 24px 60px -24px rgba(23,34,48,.35)}"," .camera{position:absolute;inset:0;transform-origin:0 0;transition:transform 1.15s var(--ease);will-change:transform}","-.camera img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.012);transition:opacity .65s var(--ease),transform .9s var(--ease);user-select:none;-webkit-user-drag:none}","-.camera img.on{opacity:1;transform:none}","+.camera img,.camera video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;user-select:none;-webkit-user-drag:none}","+.camera .on{opacity:1}","+.camera img.fade{transition:opacity .55s var(--ease)}","+.playing .hotspot{display:none}","+.frame::after{content:'';position:absolute;left:0;bottom:0;height:3px;width:var(--clip-progress,0%);background:var(--blue);opacity:.0;transition:opacity .3s}","+.playing.frame::after{opacity:.85}"," .hotspot{position:absolute;padding:0;border:2px solid var(--blue);background:rgba(6,105,215,.06);cursor:pointer;opacity:0;transform:scale(.92);transition:opacity .45s var(--ease),transform .45s var(--ease),left .9s var(--ease),top .9s var(--ease),width .9s var(--ease),height .9s var(--ease)}"," .hotspot.on{opacity:1;transform:none}"," .hotspot::before{content:'';position:absolute;inset:-2px;border:2px solid var(--blue);animation:halo 1.8s var(--ease) infinite;pointer-events:none}"]},{"oldStart":106,"oldLines":9,"newStart":114,"newLines":6,"lines":[" .hotspot.below .tag::after{top:auto;bottom:100%;border-top-color:transparent;border-bottom-color:var(--blue)}"," .hotspot:hover,.hotspot:focus-visible{background:rgba(6,105,215,.14);outline:none}"," .hotspot:focus-visible{box-shadow:0 0 0 4px rgba(6,105,215,.35)}","-.cursor{position:absolute;width:22px;height:22px;margin:-3px 0 0 -3px;pointer-events:none;transition:left .9s var(--ease),top .9s var(--ease),opacity .4s;filter:drop-shadow(0 2px 3px rgba(0,0,0,.35))}","-.cursor.click::after{content:'';position:absolute;left:-8px;top:-8px;width:20px;height:20px;border-radius:50%;border:2px solid var(--blue);animation:ripple .5s ease-out forwards}","-@keyframes ripple{from{opacity:1;transform:scale(.3)}to{opacity:0;transform:scale(1.8)}}"," "," .caption{width:min(100%,calc((100vh - 64px - 22px - 150px) * 1.6));display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:22px;padding:18px 0 22px}"," .caption .num{font-size:13px;font-weight:700;letter-spacing:.08em;color:var(--blue);font-variant-numeric:tabular-nums;white-space:nowrap}"]},{"oldStart":170,"oldLines":9,"newStart":175,"newLines":9,"lines":["   <section class=\"stage\" id=\"shot-stage\">","     <div class=\"frame\" id=\"frame\">","       <div class=\"camera\" id=\"camera\">","-        <img id=\"img-a\" alt=\"\"><img id=\"img-b\" alt=\"\">","+        <img id=\"still\" alt=\"\">","+        <video id=\"vid-a\" muted playsinline preload=\"auto\"></video><video id=\"vid-b\" muted playsinline preload=\"auto\"></video>","         <button class=\"hotspot\" id=\"hotspot\" type=\"button\"><span class=\"tag\" id=\"tag\"></span></button>","-        <svg class=\"cursor\" id=\"cursor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 2v17l4.6-4.3 3 6.8 2.8-1.2-3-6.6H17.6z\" fill=\"#fff\" stroke=\"#172230\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/></svg>","       </div>","     </div>","     <div class=\"caption\">"]},{"oldStart":187,"oldLines":13,"newStart":192,"newLines":16,"lines":[" <script>"," const STEPS = ${JSON.stringify(steps)};"," const $ = id => document.getElementById(id);","-let index = -1, front = $('img-a'), back = $('img-b'), zoomTimer = 0, hotspotTimer = 0;","+let index = -1, zoomTimer = 0, hotspotTimer = 0, playing = null;","+const videos = [$('vid-a'), $('vid-b')];","+let active = 0;"," "," const escapeHtml = value => String(value).replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));"," const shotNumber = i => STEPS.slice(0, i + 1).filter(step => step.type === 'shot' && step.chapter === STEPS[i].chapter).length;"," const shotTotal = chapter => STEPS.filter(step => step.type === 'shot' && step.chapter === chapter).length;","+const nextShot = from => STEPS.slice(from + 1).find(step => step.type === 'shot');"," ","-// Camera: zoom so the focus box fills the frame, clamped to the screenshot's edges.","+// Camera: zoom so the focus box fills the frame, clamped to the recording's edges."," function cameraFor(focus) {","   if (!focus) return { s: 1, tx: 0, ty: 0 };","   const pad = 0.04, s = Math.max(1, Math.min(2.4, 1 / (focus.w + pad * 2), 1 / (focus.h + pad * 2)));"]},{"oldStart":208,"oldLines":9,"newStart":216,"newLines":9,"lines":[" };"," "," function placeHotspot(step, cam) {","-  const spot = $('hotspot'), cursor = $('cursor');","+  const spot = $('hotspot');","   spot.classList.remove('on');","-  if (!step.hotspot || !visibleUnder(step.hotspot, cam)) { spot.hidden = true; cursor.style.opacity = 0; return; }","+  if (!step.hotspot || !visibleUnder(step.hotspot, cam)) { spot.hidden = true; return; }","   const h = step.hotspot;","   spot.hidden = false;","   Object.assign(spot.style, { left: h.x * 100 + '%', top: h.y * 100 + '%', width: h.w * 100 + '%', height: h.h * 100 + '%' });"]},{"oldStart":220,"oldLines":38,"newStart":228,"newLines":88,"lines":["   // Counter-scale the label so it stays readable when the camera zooms in.","   $('tag').style.transform = 'translateX(-50%) scale(' + 1 / cam.s + ')';","   $('tag').style.transformOrigin = h.y < 0.16 ? '50% 0' : '50% 100%';","-  cursor.style.opacity = 1;","-  cursor.style.width = cursor.style.height = 22 / cam.s + 'px';","-  cursor.style.left = (h.x + h.w * 0.6) * 100 + '%';","-  cursor.style.top = (h.y + h.h * 0.62) * 100 + '%';","-  hotspotTimer = setTimeout(() => spot.classList.add('on'), 450);","+  hotspotTimer = setTimeout(() => spot.classList.add('on'), cam.s > 1 ? 900 : 250);"," }"," ","-function showShot(step, direction) {","+// End state of a step: its last frame, zoom, hotspot.","+function settle(step, animateZoom) {","+  playing = null;","+  $('frame').classList.remove('playing');","+  $('frame').style.setProperty('--clip-progress', '0%');","+  const cam = cameraFor(step.focus);","+  clearTimeout(zoomTimer);","+  if (animateZoom) zoomTimer = setTimeout(() => applyCamera(cam), 120); else applyCamera(cam);","+  placeHotspot(step, cam);","+  $('next').textContent = step.hotspot && !$('hotspot').hidden ? 'Skip →' : 'Next →';","+  preload(index);","+}","+","+function showStill(step) {","+  const still = $('still');","+  still.classList.remove('fade');","+  still.src = step.poster;","+  still.classList.add('on');","+  videos.forEach(v => { v.pause(); v.classList.remove('on'); });","+}","+","+// Keep the next clip buffered in the idle video element.","+function preload(from) {","+  const upcoming = nextShot(from);","+  const idle = videos[1 - active];","+  if (upcoming && !idle.src.endsWith(upcoming.clip)) { idle.src = upcoming.clip; idle.load(); }","+}","+","+function playClip(step) {","+  const video = videos.find(v => v.src.endsWith(step.clip)) || videos[1 - active];","+  if (!video.src.endsWith(step.clip)) { video.src = step.clip; video.load(); }","+  active = videos.indexOf(video);","+  playing = step;","+  $('frame').classList.add('playing');","+  $('next').textContent = 'Skip clip ⇥';","+  applyCamera({ s: 1, tx: 0, ty: 0 });","+  video.currentTime = 0;","+  const start = () => {","+    if (playing !== step) return;","+    video.classList.add('on');","+    // The clip opens on the previous end frame, so hiding the still is seamless.","+    requestAnimationFrame(() => { $('still').classList.remove('on'); videos.forEach(v => v !== video && v.classList.remove('on')); });","+  };","+  video.onplaying = start;","+  video.ontimeupdate = () => { if (video.duration) $('frame').style.setProperty('--clip-progress', (video.currentTime / video.duration * 100) + '%'); };","+  video.onended = () => { if (playing !== step) return; showStill(step); settle(step, true); };","+  video.play().catch(() => { showStill(step); settle(step, false); });","+}","+","+function skipClip() {","+  if (!playing) return;","+  const step = playing;","+  videos.forEach(v => { v.onended = null; v.pause(); });","+  showStill(step);","+  settle(step, true);","+}","+","+function showShot(step, previous, direction) {","   $('slide-stage').classList.remove('on');","   $('shot-stage').classList.add('on');","   document.body.classList.remove('dark');","   clearTimeout(zoomTimer); clearTimeout(hotspotTimer);","-  [front, back] = [back, front];","-  front.src = step.src; front.alt = step.title;","-  back.classList.remove('on');","-  requestAnimationFrame(() => front.classList.add('on'));","-  const cam = cameraFor(step.focus);","-  applyCamera({ s: 1, tx: 0, ty: 0 });","-  if (step.focus) zoomTimer = setTimeout(() => applyCamera(cam), direction === 0 ? 0 : 650);","-  placeHotspot(step, cam);","+  $('hotspot').classList.remove('on');","   $('num').textContent = String(shotNumber(index)).padStart(2, '0') + ' / ' + String(shotTotal(step.chapter)).padStart(2, '0');","   $('copy').innerHTML = '<h2>' + escapeHtml(step.title) + '</h2><p>' + escapeHtml(step.text) + '</p>';","-  $('next').textContent = step.hotspot ? 'Skip →' : 'Next →';","+  // Moving forward one step plays the recording; anything else jumps straight to the end state.","+  if (direction === 1 && previous >= 0 && STEPS.indexOf(nextShot(previous)) === index) playClip(step);","+  else { showStill(step); settle(step, false); }"," }"," "," function showSlide(step) {","+  playing = null;","+  videos.forEach(v => v.pause());","   $('shot-stage').classList.remove('on');","-  const stage = $('slide-stage');","-  stage.classList.add('on');","+  $('slide-stage').classList.add('on');","   document.body.classList.add('dark');","   $('slide').innerHTML = step.html;","   $('slide').querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));","+  preload(index);"," }"," "," function go(target, direction = 1) {"]},{"oldStart":259,"oldLines":7,"newStart":317,"newLines":7,"lines":["   const previous = index;","   index = target;","   const step = STEPS[index];","-  if (step.type === 'shot') showShot(step, previous < 0 ? 0 : direction);","+  if (step.type === 'shot') showShot(step, previous, Math.abs(target - previous) === 1 ? direction : 0);","   else showSlide(step);","   $('counter').textContent = (index + 1) + ' / ' + STEPS.length;","   $('progress').style.width = ((index + 1) / STEPS.length * 100) + '%';"]},{"oldStart":269,"oldLines":32,"newStart":327,"newLines":25,"lines":["   history.replaceState(null, '', '#' + (index + 1));"," }"," ","-function clickHotspot() {","-  const cursor = $('cursor');","-  cursor.classList.remove('click'); void cursor.offsetWidth; cursor.classList.add('click');","-  setTimeout(() => go(index + 1), 260);","-}","-","-$('hotspot').addEventListener('click', clickHotspot);","-$('next').addEventListener('click', () => go(index + 1));","+const advance = () => (playing ? skipClip() : go(index + 1));","+$('hotspot').addEventListener('click', () => go(index + 1));","+$('next').addEventListener('click', advance);"," $('back').addE