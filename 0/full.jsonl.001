r wording and the storyline."," set -e","-REPO=\"$(cd \"$(dirname \"$0\")/../..\" && pwd)\"","-WORK=/tmp/walkthrough-capture","-PORT=4175","-pkill -f \"user-data-dir=$WORK/profile\" 2>/dev/null || true","-[ -f \"$WORK/server.pid\" ] && kill \"$(cat \"$WORK/server.pid\")\" 2>/dev/null || true","-rm -rf \"$WORK/shots\" \"$WORK/webp\"; mkdir -p \"$WORK/shots\" \"$WORK/webp\"","-rsync -a --delete --exclude .git --exclude .impeccable --exclude node_modules --exclude walkthrough \"$REPO/\" \"$WORK/app/\"","-: > \"$WORK/app/data/decision-events.ndjson\"; rm -f \"$WORK/app/data/uploads.json\"","-(cd \"$WORK/app\" && PORT=$PORT node server.mjs > \"$WORK/server.log\" 2>&1 & echo $! > \"$WORK/server.pid\")","-sleep 1.5","-trap 'kill \"$(cat \"$WORK/server.pid\")\" 2>/dev/null || true' EXIT","-node \"$REPO/walkthrough/tools/capture.mjs\" \"http://localhost:$PORT\" \"$WORK/shots\" \"$REPO/demo-data\"","-for f in \"$WORK\"/shots/*.png; do cwebp -quiet -q 80 -m 6 \"$f\" -o \"$WORK/webp/$(basename \"${f%.png}\").webp\"; done","-node \"$REPO/walkthrough/tools/build.mjs\" \"$WORK/shots\" \"$WORK/webp\" \"$REPO/walkthrough/index.html\"","+TOOLS=\"$(cd \"$(dirname \"$0\")\" && pwd)\"; REPO=\"$(cd \"$TOOLS/../..\" && pwd)\"; WORK=/tmp/walkthrough-capture","+\"$TOOLS/rec.sh\"","+node \"$TOOLS/encode.mjs\" \"$WORK/rec\" \"$WORK/media\"","+node \"$TOOLS/build.mjs\" \"$WORK/media\" \"$REPO/walkthrough\""]}]}],"moreFiles":41,"changedFiles":["/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL/walkthrough/index.html","/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL/walkthrough/media/01-01-setup.mp4","/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL/walkthrough/media/01-01-setup.webp","/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL/walkthrough/media/02-02-evidence.mp4","/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL/walkthrough/media/02-02-evid