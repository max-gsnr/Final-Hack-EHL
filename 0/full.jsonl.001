script>","-const STEPS = [{\"type\":\"slide\",\"chapter\":\"intro\",\"kind\":\"title\",\"html\":\"<p class=\\\"kicker-line\\\">BMW Product Intelligence</p><h1 class=\\\"display\\\">From thousands of customer voices<br>to requirements a PM can defend.</h1><p class=\\\"lede\\\">A recorded, clickable walkthrough of the live demo. Click the highlighted control, or press <kbd>→</kbd>.</p><button class=\\\"start\\\" data-next>Start the demo <span aria-hidden=\\\"true\\\">→</span></button>\"},{\"type\":\"shot\",\"chapter\":\"demo1\",\"title\":\"Set the upfront requirements\",\"text\":\"Vehicle, market, time to market, team size and how much the deadline matters. Every ranking is filtered and weighted against this.\",\"label\":\"Add evidence\",\"clip\":\"media/01-01-setup.mp4\",\"poster\":\"media/01-01-setup.webp\",\"hotspot\":{\"x\":0.048328993055555554,\"y\":0.7084027777777778,\"w\":0.1510525173611111,\"h\":0.17463541666666665},\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo1\",\"title\":\"Add your own evidence\",\"text\":\"Customer feedback, market data, global trends or past decisions. Here: a customer-feedback CSV, weighted the same as BMW data.\",\"label\":\"Preview rows\",\"clip\":\"media/02-02-evidence.mp4\",\"poster\":\"media/02-02-evidence.webp\",\"hotspot\":{\"x\":0.8084743923611111,\"y\":0.6422048611111111,\"w\":0.11986762152777777,\"h\":0.05814236111111111},\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo1\",\"title\":\"Check it before it counts\",\"text\":\"Every row is matched to an existing feature. The PM corrects anything wrong before it enters the knowledge base.\",\"label\":\"Add 8 rows\",\"clip\":\"media/03-03-preview.mp4\",\"poster\":\"media/03-03-preview.webp\",\"hotspot\":{\"x\":0.7070638020833333,\"y\":0.80046875,\"w\":0.24460720486111112,\"h\":0.05814236111111111},\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo1\",\"title\":\"Generate\",\"text\":\"BMW 5 Series, United States, 18 months, 12 people, deadline 8/10, plus 8 rows of our own evidence.\",\"label\":\"Generate requirements\",\"clip\":\"media/04-04-generate.mp4\",\"poster\":\"media/04-04-generate.webp\",\"hotspot\":{\"x\":0.6516710069444445,\"y\":0.6202604166666666,\"w\":0.3,\"h\":0.07465277777777778},\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo1\",\"title\":\"Ranked requirements per vehicle domain\",\"text\":\"Interior & Comfort. Seating comfort sits at #2, behind the audio settings.\",\"label\":\"Evidence & reasoning\",\"clip\":\"media/05-05-requirements.mp4\",\"poster\":\"media/05-05-requirements.webp\",\"hotspot\":{\"x\":0.3024848090277778,\"y\":0.7108333333333333,\"w\":0.10469835069444444,\"h\":0.021267361111111112},\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo1\",\"title\":\"Reasoning anyone can check\",\"text\":\"Why it exists, why #2, what our upload added, and what makes up the score: customer demand, timeline fit, market evidence and competitor data. No past decisions yet.\",\"label\":\"View cited sources\",\"clip\":\"media/06-06-reasoning.mp4\",\"poster\":\"media/06-06-reasoning.webp\",\"hotspot\":{\"x\":0.3224826388888889,\"y\":0.9224131944444445,\"w\":0.09088541666666666,\"h\":0.025121527777777777},\"focus\":{\"x\":0.3024848090277778,\"y\":0.3436458333333333,\"w\":0.6458550347222223,\"h\":0.6252083333333334}},{\"type\":\"shot\",\"chapter\":\"demo1\",\"title\":\"Every claim has a source, competitors included\",\"text\":\"Nine competitor signals from the workbook: Mercedes E-Class and Audi A6 reports and equipment lists, each linked to its row and original source.\",\"label\":\"\",\"clip\":\"media/07-06b-competitors.mp4\",\"poster\":\"media/07-06b-competitors.webp\",\"hotspot\":null,\"focus\":{\"x\":0.4340277777777778,\"y\":0.00024305555555555555,\"w\":0.5326388888888889,\"h\":0.7989756944444445}},{\"type\":\"shot\",\"chapter\":\"demo1\",\"title\":\"Back to the ranking\",\"text\":\"The PM has seen the evidence. Now they decide.\",\"label\":\"Move up\",\"clip\":\"media/08-06c-move-up.mp4\",\"poster\":\"media/08-06c-move-up.webp\",\"hotspot\":{\"x\":0.7076171875,\"y\":0.9224131944444445,\"w\":0.04235026041666667,\"h\":0.025121527777777777},\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo1\",\"title\":\"The PM decides the order\",\"text\":\"Seating comfort moves to #1. The AI proposes; the PM decides.\",\"label\":\"Approve\",\"clip\":\"media/09-07-moved.mp4\",\"poster\":\"media/09-07-moved.webp\",\"hotspot\":{\"x\":0.8625217013888888,\"y\":0.3097048611111111,\"w\":0.03166232638888889,\"h\":0.050659722222222224},\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo1\",\"title\":\"One sentence on why\",\"text\":\"The reason is saved with the decision in Decision Memory.\",\"label\":\"Approve requirement\",\"clip\":\"media/10-08-approve.mp4\",\"poster\":\"media/10-08-approve.webp\",\"hotspot\":{\"x\":0.7040907118055556,\"y\":0.82578125,\"w\":0.24688585069444444,\"h\":0.055989583333333336},\"focus\":{\"x\":0.4340277777777778,\"y\":0.4609027777777778,\"w\":0.5326388888888889,\"h\":0.4459722222222222}},{\"type\":\"shot\",\"chapter\":\"demo1\",\"title\":\"Approved, with its reason\",\"text\":\"This is what the challenge asked for.\",\"label\":\"\",\"clip\":\"media/11-09-approved.mp4\",\"poster\":\"media/11-09-approved.webp\",\"hotspot\":null,\"focus\":null},{\"type\":\"slide\",\"chapter\":\"gap\",\"kind\":\"scope\",\"html\":\"<p class=\\\"kicker-line\\\">The challenge</p><h2 class=\\\"display\\\">That was the brief.<br>And what every team built.</h2><ol class=\\\"scope-list\\\"><li><span>01</span>Upfront requirements</li><li><span>02</span>Evidence in</li><li><span>03</span>Ranked requirements with reasoning</li><li><span>04</span>PM decides</li></ol><p class=\\\"lede\\\">So we went back and talked to product managers.</p>\"},{\"type\":\"slide\",\"chapter\":\"gap\",\"kind\":\"quote\",\"html\":\"<blockquote class=\\\"quote\\\"><span style=\\\"--i:0\\\">When</span> <span style=\\\"--i:1\\\">I</span> <span style=\\\"--i:2\\\">join</span> <span style=\\\"--i:3\\\">a</span> <span style=\\\"--i:4\\\">project</span> <span style=\\\"--i:5\\\">during</span> <span style=\\\"--i:6\\\">a</span> <span style=\\\"--i:7\\\">handover,</span> <span style=\\\"--i:8\\\">I</span> <span style=\\\"--i:9\\\">have</span> <span style=\\\"--i:10\\\">zero</span> <span style=\\\"--i:11\\\">context</span> <span style=\\\"--i:12\\\">on</span> <span style=\\\"--i:13\\\">what</span> <span style=\\\"--i:14\\\">was</span> <span style=\\\"--i:15\\\">decided</span> <span style=\\\"--i:16\\\">before,</span> <span style=\\\"--i:17\\\">or</span> <span style=\\\"--i:18\\\">why.</span> <span style=\\\"--i:19\\\">I’d</span> <span style=\\\"--i:20\\\">love</span> <span style=\\\"--i:21\\\">to</span> <span style=\\\"--i:22\\\">see</span> <span style=\\\"--i:23\\\">the</span> <span style=\\\"--i:24\\\">project’s</span> <span style=\\\"--i:25\\\">past</span> <span style=\\\"--i:26\\\">decisions</span> <span style=\\\"--i:27\\\">and</span> <span style=\\\"--i:28\\\">the</span> <span style=\\\"--i:29\\\">reasons</span> <span style=\\\"--i:30\\\">behind</span> <span style=\\\"--i:31\\\">them.</span></blockquote><p class=\\\"attribution\\\"><strong>Former Product Manager, Vodafone</strong><span>Quoted with his consent</span></p>\"},{\"type\":\"slide\",\"chapter\":\"demo2\",\"kind\":\"divider\",\"html\":\"<p class=\\\"kicker-line\\\">Demo 2</p><h2 class=\\\"display\\\">A handover.<br>The new PM starts with the memory, not from zero.</h2>\"},{\"type\":\"shot\",\"chapter\":\"demo2\",\"title\":\"A new PM joins the project\",\"text\":\"Day one: the Project Diary shows every change and decision on this vehicle, day by day.\",\"label\":\"Storyline\",\"clip\":\"media/12-10-diary.mp4\",\"poster\":\"media/12-10-diary.webp\",\"hotspot\":{\"x\":0.03166232638888889,\"y\":0.8775868055555556,\"w\":0.23333333333333334,\"h\":0.05333333333333334},\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo2\",\"title\":\"Pick the onboarding storyline\",\"text\":\"From the first recorded decision to today.\",\"label\":\"Onboarding\",\"clip\":\"media/13-11-storyline-menu.mp4\",\"poster\":\"media/13-11-storyline-menu.webp\",\"hotspot\":{\"x\":0.03235677083333333,\"y\":0.6553645833333334,\"w\":0.23194444444444445,\"h\":0.06097222222222222},\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo2\",\"title\":\"The whole project history\",\"text\":\"Every recorded change in the range goes into the storyline.\",\"label\":\"Generate storyline\",\"clip\":\"media/14-12-storyline-range.mp4\",\"poster\":\"media/14-12-storyline-range.webp\",\"hotspot\":{\"x\":0.5165907118055556,\"y\":0.4009201388888889,\"w\":0.12323133680555555,\"h\":0.05333333333333334},\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo2\",\"title\":\"The project in five minutes\",\"text\":\"What was decided, in what order, and why, each linked back to the recorded event.\",\"label\":\"\",\"clip\":\"media/15-13-storyline.mp4\",\"poster\":\"media/15-13-storyline.webp\",\"hotspot\":null,\"focus\":{\"x\":0.03166232638888889,\"y\":0.13300347222222222,\"w\":0.9366753472222222,\"h\":0.7813715277777777}},{\"type\":\"shot\",\"chapter\":\"demo2\",\"title\":\"The new PM sets their own constraints\",\"text\":\"24 months, 8 people, deadline priority 5/10. Same vehicle, same market.\",\"label\":\"\",\"clip\":\"media/16-14-setup-again.mp4\",\"poster\":\"media/16-14-setup-again.webp\",\"hotspot\":null,\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo2\",\"title\":\"Generate again\",\"text\":\"Nothing new uploaded. Decision Memory travels with the project.\",\"label\":\"Generate requirements\",\"clip\":\"media/17-14b-generate-again.mp4\",\"poster\":\"media/17-14b-generate-again.webp\",\"hotspot\":{\"x\":0.6516710069444445,\"y\":0.6202604166666666,\"w\":0.3,\"h\":0.07465277777777778},\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo2\",\"title\":\"Seating comfort leads, tagged Past decision\",\"text\":\"The new PM sees immediately that this requirement already has history.\",\"label\":\"Evidence & reasoning\",\"clip\":\"media/18-15-requirements-again.mp4\",\"poster\":\"media/18-15-requirements-again.webp\",\"hotspot\":{\"x\":0.3024848090277778,\"y\":0.7108854166666667,\"w\":0.10469835069444444,\"h\":0.021267361111111112},\"focus\":null},{\"type\":\"shot\",\"chapter\":\"demo2\",\"title\":\"The previous PM’s reasoning, on the requirement\",\"text\":\"Decision Memory shows who approved it, when, and why. No upload, no search: it travels with the project.\",\"label\":\"\",\"clip\":\"media/19-16-memory.mp4\",\"poster\":\"media/19-16-memory.webp\",\"hotspot\":null,\"focus\":{\"x\":0.3224826388888889,\"y\":0.5878472222222222,\"w\":0.605859375,\"h\":0.16588541666666667}},{\"type\":\"shot\",\"chapter\":\"demo2\",\"title\":\"And it carries weight in the ranking\",\"text\":\"Past decisions are now part of the score, next to customer demand, timeline fit, market evidence and competitor data.\",\"label\":\"\",\"clip\":\"media/20-16b-score.mp4\",\"poster\":\"media/20-16b-score.webp\",\"hotspot\":null,\"focus\":{\"x\":0.3224826388888889,\"y\":0.621875,\"w\":0.605859375,\"h\":0.12916666666666668}},{\"type\":\"slide\",\"chapter\":\"close\",\"kind\":\"close\",\"html\":\"<p class=\\\"kicker-line\\\">Product Intelligence</p><h2 class=\\\"display\\\">Vehicle projects run for years.<br>PMs change. Decisions shouldn’t get lost.</h2><ul class=\\\"pillars\\\"><li><strong>Decision memory</strong><span>Every approval and rejection keeps its reason, and the reason counts in the next ranking.</span></li><li><strong>Onboarding</strong><span>A new PM reads the project’s story before the first meeting.</span></li><li><strong>Handover</strong><span>The next cycle starts where the last one left off.</span></li></ul><p class=\\\"lede\\\">We don’t replace product managers. We give them the memory of everyone who came before.</p>\"}];","+const STEPS = [{\"type\":\"slide\",\"chapter\":\"intro\",\"kind\":\"title\",\"html\":\"<p class=\\\"kicker-line\\\">BMW Product Intelligence</p><h1 class=\\\"display\\\">From thousands o