mory-side .revisit { display: inline-flex; align-items: center; gap: 10px; margin-top: 31px; color: var(--green); font-size: 14px; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; }","-    .revisit i { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }","-","-    /* Closing */","-    .closing { background: linear-gradient(120deg, #071b2c 0%, #102c43 56%, #162b42 100%); }","-    .closing::before { opacity: .25; background-image: radial-gradient(#6f9fbe 1px, transparent 1px); mask-image: none; }","-    .closing .brand { color: #f4f7fb; }","-    .closing .brand-mark { border-color: #b4c8d8; background: conic-gradient(#eaf3fa 0 25%, #5b9ed0 0 50%, #eaf3fa 0 75%, #5b9ed0 0); }","-    .closing .slide-count { color: #adc1d0; }","-    .closing .content { position: absolute; top: 294px; left: 228px; width: 1320px; }","-    .closing .eyebrow { color: #77b8e7; }","-    .closing h2 { margin-top: 29px; color: #fff; font-size: 103px; line-height: .93; }","-    .closing h2 strong { color: #77b8e7; font-weight: 400; }","-    .closing .closing-sub { width: 600px; margin-top: 38px; color: #c5d4df; font-size: 24px; line-height: 1.55; }","-    .closing-line { position: absolute; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(209,229,244,.25); }","-    .closing-line span { padding: 27px 0 27px 228px; color: #abc0cf; font-size: 15px; font-weight: 500; }","-    .closing-line span + span { padding-left: 48px; border-left: 1px solid rgba(209,229,244,.25); }","-","-    .reveal .slides section .fragment { transition: opacity .65s var(--ease), transform .65s var(--ease); }","-    .fragment.rise { transform: translateY(20px); } .fragment.rise.visible { transform: translateY(0); }","-    .fragment.in { transform: scale(.97); } .fragment.in.visible { transform: scale(1); }","-    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; } }","-  </style>","-</head>","-<body>","-  <div class=\"reveal\">","-    <div class=\"slides\">","-      <section data-auto-animate data-transition=\"fade\">","-        <div class=\"slide opening\">","-          <div class=\"frame\">","-            <div class=\"opening-copy\">","-              <p class=\"eyebrow\">BMW Product Intelligence</p>","-              <h1>Would BMW make<br>this <strong>decision</strong> today?</h1>","-              <p class=\"subhead\">A product strategy workspace that turns evidence into decisions the next PM can understand, challenge, and revisit.</p>","-            </div>","-            <div class=\"arc\"><i class=\"arc-dot\"></i></div>","-            <div class=\"opening-meta\"><span>5 Series · G60</span><span>United States</span><span>18 months</span></div>","-          </div>","-          <aside class=\"notes\">[0:00–0:15] “BMW product decisions live longer than the people who make them. Our question is simple: would BMW make the same decision today?”</aside>","-        </div>","-      </section>","-","-      <section data-auto-animate data-transition=\"fade\">","-        <div class=\"slide problem statement\">","-          <div class=\"frame\">","-            <p class=\"brand\" data-id=\"brand\"><i class=\"brand-mark\"></i>BMW Product Intelligence</p>","-            <p class=\"slide-count\">01 / 06</p>","-            <div class=\"content\">","-              <div>","-                <p class=\"eyebrow\">The handover problem</p>","-                <h2>Decisions outlive their authors.</h2>","-                <blockquote class=\"fragment rise\">“I have too much data to look at, and zero memory of why the previous PM made their design choices.”</blockquote>","-                <cite class=\"fragment rise\">Senior product manager interview</cite>","-              </div>","-              <div class=\"handover fragment in\">","-                <i class=\"handover-line\"></i>","-                <div class=\"handover-step now\">G60<br>decision made</div>","-                <div class=\"handover-step gap\">Reasoning<br>lost</div>","-                <div class=\"handover-step next\">New PM<br>inherits it</div>","-              </div>","-            </div>","-          </div>","-          <aside class=\"notes\">[0:15–0:35] “This is the handover gap. A new PM inherits a specification, but the trade-offs and assumptions behind it have disappeared.”</aside>","-        </div>","-      </section>","-","-      <section data-auto-animate data-transition=\"fade\">","-        <div class=\"slide evidence\">","-          <div class=\"frame\">","-            <p class=\"brand\" data-id=\"brand\"><i class=\"brand-mark\"></i>BMW Product Intelligence</p>","-            <p class=\"slide-count\">02 / 06</p>","-            <div class=\"content\">","-              <div class=\"evidence-heading\">","-                <div><p class=\"eyebrow\">The G60 signal</p><h2>Evidence is abundant.<br>Context is scarce.</h2></div>","-                <p class=\"data-total\">BMW 5 Series · US</p>","-              </div>","-              <div class=\"signal-grid\">","-                <article data-id=\"signal-records\"><p class=\"signal-number\">4,365</p><h3>US feedback records</h3><p>Customer input spans product experience, equipment, quality and use.</p></article>","-                <article data-id=\"signal-friction\"><p class=\"signal-number blue\">1,217</p><h3>Marked “Difficult to Use”</h3><p>Signals that deserve more weight than a generic wish list.</p></article>","-                <article class=\"fragment rise\"><p class=\"feedback-quote\">the electronics are very complicated and difficult to understand. Manual buttons and wheel controls reduce distraction.</p><p class=\"evidence-source\">G60 customer feedback · United States</p></article>","-              </div>","-            </div>","-          </div>","-          <aside class=\"notes\">[0:35–0:55] “For the G60 in the United States, we have 4,365 feedback records. 1,217 are classified as difficult to use. The point is not another dashboard; it is helping the PM turn this evidence into a defensible customer requirement.” Source: G60_feedback_hackathon.xlsx, US filter.</aside>","-        </div>","-      </section>","-","-      <section data-auto-animate data-transition=\"fade\">","-        <div class=\"slide requirement\">","-          <div class=\"frame\">","-            <p class=\"brand\" data-id=\"brand\"><i class=\"brand-mark\"></i>BMW Product Intelligence</p>","-            <p class=\"slide-count\">03 / 06</p>","-            <div class=\"content\">","-              <div class=\"heading-row\"><div><p class=\"eyebrow\">One requirement, fully traceable</p><h2>Make the trade-off visible.</h2></div><p class=\"label\">The PM remains in control.</p></div>","-              <div class=\"requirement-card\">","-                <aside><p>Customer outcome</p><strong>Less distraction.<br>More confidence.</strong></aside>","-                <div class=\"requirement-main\">","-                  <h3>Enable essential driving and comfort functions through intuitive, low-distraction interaction.</h3>","-                  <p class=\"proof-line\"><i></i><span>Linked to the G60 feedback pattern, target market and product focus.</span></p>","-                </div>","-              </div>","-              <div class=\"decision-path fragment rise\">","-                <div><span>01</span><strong>Evidence</strong></div>","-                <div><span>02</span><strong>Context</strong></div>","-                <div><span>03</span><strong>PM decision</strong></div>","-                <div><span>04</span><strong>Decision memory</strong></div>","-              </div>","-            </div>","-          </div>","-          <aside class=\"notes\">[0:55–1:15] “The system turns evidence into a customer-facing requirement, while keeping the logic exposed: evidence, context, the PM’s decision, and the reason it was made.”</aside>","-        </div>","-      </section>","-","-      <section id=\"live-demo\" data-background-color=\"#f4f7fb\" data-background-interactive data-transition=\"fade\">","-        <div class=\"slide\">","-          <div class=\"demo-hud\"><p>BMW Product Intelligence · Live workspace</p><span id=\"demo-status\" class=\"demo-status\"><i></i>Connecting</span></div>","-          <div id=\"demo-fallback\" class=\"demo-fallback\" hidden>","-            <div class=\"demo-fallback-inner\"><p class=\"eyebrow\">Live demo unavailable</p><h2>Start the workspace, then return to this slide.</h2><p>The deck will connect automatically when the app is running.</p><code>npm start</code></div>","-          </div>","-        </div>","-        <aside class=\"notes\">[1:15–2:20] “Now I will make this decision in the workspace. I set the vehicle, market and delivery context; generate grounded requirements; inspect a cited recommendation; then approve or reject it with a reason. Rejection recalibrates the group while keeping the decision trail.” [CLICK NEXT BUTTON AFTER DEMO]</aside>","-      </section>","-","-      <section data-auto-animate data-transition=\"fade\">","-        <div class=\"slide memory\">","-          <div class=\"frame\">","-            <p class=\"brand\" data-id=\"brand\"><i class=\"brand-mark\"></i>BMW Product Intelligence</p>","-            <p class=\"slide-count\">05 / 06</p>","-            <div class=\"content\">","-              <p class=\"eyebrow\">Decision memory</p>","-              <h2>Keep the why.<br>Revisit the decision.</h2>","-              <div class=\"memory-layout\">","-                <div class=\"memory-list\">","-                  <div class=\"memory-event\"><time>Today</time><i class=\"memory-dot\"></i><div><strong>PM approves a requirement</strong><p>Decision context and rationale are attached to the evidence.</p></div></div>","-                  <div class=\"memory-event\"><time>Next cycle</time><i class=\"memory-dot\"></i><div><strong>New PM opens the record</strong><p>The prior trade-off is understandable before it is reused.</p></div></div>","-                  <div class=\"memory-event new\"><time>New signal</time><i class=\"memory-dot\"></i><div><strong>Changed evidence triggers review</strong><p>The PM sees what changed and decides whether to retain or revise it.</p></div></div>","-                </div>","-                <aside class=\"memory-side fragment rise\"><p class=\"eyebrow\">The difference</p><h3>Memory becomes active.</h3><p>It preserves the original decision and gives the next PM a clear reason to challenge it.</p><span class=\"revisit\"><i></i> Ready to revisit</span></aside>","-              </div>","-            </div>","-          </div>","-          <aside class=\"notes\">[2:20–2:40] “The competitive edge is not storing a note. It is preserving an evidence-backed decision so the next PM can see whether the underlying assumptions are still true.”</aside>","-        </div>","-      </section>","-","-      <section data-auto-animate data-transition=\"fade\">","-        <div class=\"slide closing\">","-          <div class=\"frame\">","-            <p class=\"brand\" data-id=\"brand\"><i class=\"brand-mark\"></i>BMW Product Intelligence</p>","-            <p class=\"slide-count\">06 / 06</p>","-            <div class=\"content\">","-              <p class=\"eyebrow\">The 7-year question</p>","-              <h2>BMW does not<br>lose the <strong>why.</strong></h2>","-              <p class=\"closing-sub\">From evidence to a decision BMW can defend today—and revisit when the world changes.</p>","-            </div>","-          </div>","-          <div class=\"closing-line\"><span>Evidence-linked</span><span>PM-controlled</span><span>Built for the next cycle</span></div>","-          <aside class=\"notes\">[2:40–3:00] “BMW Product Intelligence turns an inherited decision into a transparent starting point for the next product cycle. Evidence-linked, PM-controlled, and ready to be revisited. Thank you.”</aside>","-        </div>","-      </section>","-    </div>","-  </div>","-","-  <button id=\"demo-next\" class=\"demo-next\" type=\"button\">Continue <span>→</span></button>","-","-  <script src=\"https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/reveal.js\"></script>","-  <script src=\"https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/plugin/notes/notes.js\"></script>","-  <script>","-    const DEMO_URL = new URLSearchParams(location.search).get('demo') || 'http://localhost:4173/';","-    const demoSlide = document.getElementById('live-demo');","-    const demoFallback = document.getElementById('demo-fallback');","-    const demoStatus = document.getElementById('demo-status');","-","-    Reveal.initialize({","-      width: 1920,","-      height: 1080,","-      margin: 0,","-      minScale: 0.1,","-      maxScale: 2,","-      center: true,","-      hash: true,","-      controls: false,","-      progress: true,","-      slideNumber: false,","-      transition: 'fade',","-      transitionSpeed: 'slow',","-      backgroundTransition: 'fade',","-      autoAnimateDuration: 1,","-      autoAnimateEasing: 'cubic-bezier(.65, 0, .35, 1)',","-      autoAnimateUnmatched: true,","-      plugins: [ RevealNotes ]","-    });","-","-    async function connectDemo() {","-      try {","-        await fetch(DEMO_URL, { mode: 'no-cors', signal: AbortSignal.timeout(1600) });","-        demoSlide.setAttribute('data-background-iframe', DEMO_URL);","-        demoSlide.setAttribute('data-background-interactive', '');","-        demoFallback.hidden = true;","-        demoStatus.innerHTML = '<i></i>Live';","-      } catch {","-        demoFallback.hidden = false;","-        demoStatus.textContent = 'Offline';","-      }","-      Reveal.sync();","-    }","-","-    Reveal.on('slidechanged', event => {","-      document.body.classList.toggle('on-demo', event.currentSlide.id === 'live-demo');","-    });","-","-    document.getElementById('demo-next').addEventListener('click', () => {","-      window.focus();","-      Reveal.next();","-    });","-","-    connectDemo();","-  </script>","-</body>","-</html>"]}],"deleted":true}],"moreFiles":2,"changedFiles":["/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL/data/decision-events.ndjson","/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL/presentation/assets/concept-car.webp","/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL/presentation/assets/concept-car.webp.json","/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL/presentation/assets/keynote-ground.webp","/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL/presentation/assets/keynote-ground.webp.json","/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL/presentation/index.html"]}},"serverClassifierContext":{"request":"005dd6db-eba1-40fe-bc69-4e36c468b247","context":{"git_state":{"cwd":"/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL","root":"/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"max-gsnr/Final-Hack-EHL","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"max-gsnr/Final-Hack-EHL","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"max-gsnr/Final-Hack-EHL","visibility":"unknown"}]}},"live_cwd":"/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL","platform":"macos"}},"sourceToolAssistantUUID":"0c8d63ad-7cd8-41d4-87a1-c6e1c19d7bae","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"944dad4c-792b-4da5-b8a1-9392d6587dfe","userType":"external","entrypoint":"cli","cwd":"/U