eep(1200);\nawait js(`[...document.querySelectorAll('.group-button')].find(b=>/Interior/.test(b.textContent)).click()`);\nawait sleep(600);\nconsole.log('Interior ranking, demo 1:\\n' + await ranking());\nawait markCard('/seating comfort/i');\nawait js(`window.scrollTo(0,0)`); await sleep(300);\nawait shot('05-requirements', '[data-demo] .card-reasoning summary', { meta: { chapter: 'demo1' } });\n\nawait js(`document.querySelector('[data-demo] .card-reasoning').open=true`);\nawait scrollTo('[data-demo]', 110);\nawait shot('06-reasoning', '[data-demo] [data-up]', { focus: '[data-demo] .reasoning-panel', meta: { chapter: 'demo1' } });\n\nawait click('[data-demo] [data-up]');\nawait sleep(600);\nawait markCard('/seating comfort/i');\nconsole.log('After move up:\\n' + await ranking());\nawait js(`document.querySelectorAll('.card-reasoning').forEach(d=>d.open=false)`);\nawait scrollTo('[data-demo]', 130);\nawait shot('07-moved', '[data-demo] [data-approve]', { meta: { chapter: 'demo1' } });\n\nawait click('[data-demo] [data-approve]');\nawait waitFor(`document.getElementById('detail-dialog').open`);\nawait sleep(600);\nawait typeInto('#pm-rationale', 'Moved seating comfort to #1: seat complaints and defects are a real pain point on long US drives, while the audio settings mostly need clearer controls.');\nawait js(`document.getElementById('pm-rationale').scrollIntoView({block:'center'})`);\nawait shot('08-approve', '#approve-requirement', { focus: '#detail-dialog .decision-box', meta: { chapter: 'demo1' } });\n\nawait click('#approve-requirement');\nawait waitFor(`!document.getElementById('detail-dialog').open`);\nawait sleep(900);\nawait markCard('/seating comfort/i');\nawait js(`document.querySelectorAll('.card-reasoning').forEach(d=>d.open=false)`);\nawait scrollTo('[data-demo]', 130);\nawait shot('09-approved', null, { meta: { chapter: 'demo1' } });\n\n// ---------- Demo 2: onboarding a new PM ----------\nawait click('#new-feature-button');\nawait sleep(900);\nawait 