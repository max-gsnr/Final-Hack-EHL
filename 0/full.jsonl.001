ow.SpeechRecognition=class{start(){const words=${JSON.stringify('Moved seating comfort to number one. Seat complaints and defects are a real pain point on long US drives, while the audio settings mostly need clearer controls.')}.split(' ');let i=0;const tick=()=>{i=Math.min(words.length,i+1+(Math.random()<.35?1:0));this.onresult?.({results:[[{transcript:words.slice(0,i).join(' ')}]]});if(i<words.length)setTimeout(tick,150+Math.random()*170);else setTimeout(()=>this.onend?.(),900)};setTimeout(tick,900)}stop(){this.onend?.()}}`);\nawait click('#record-rationale');\nawait waitFor(`/Dictate/.test(document.getElementById('record-rationale').textContent)&&document.getElementById('pm-rationale').value.length>40`, 60000);\nawait sleep(500);\"\"\")\n# date shift + reload before demo 2\nrep(\"\"\"await mark('09-approved', null);\n\"\"\",\"\"\"await mark('09-approved', null);\n\n// Six months later: shift every record from demo 1 back in time, on the server and in the browser.\nconst shiftAt = (events, delta) => events.map(event => ({ ...event, at: new Date(Date.parse(event.at) + delta).toISOString() }));\nconst eventsFile = join(APP_DATA, 'decision-events.ndjson');\nconst serverEvents = readFileSync(eventsFile, 'utf8').split('\\\\n').filter(Boolean).map(line => JSON.parse(line));\nconst delta = Date.parse(HANDOVER_FROM) - Math.max(...serverEvents.map(event => Date.parse(event.at)));\nwriteFileSync(eventsFile, shiftAt(serverEvents, delta).map(event => JSON.stringify(event)).join('\\\\n') + '\\\\n');\nawait js(`(()=>{const events=JSON.parse(localStorage.getItem('decision-events')||'[]').map(e=>({...e,at:new Date(Date.parse(e.at)+${delta}).toISOString()}));localStorage.setItem('decision-events',JSON.stringify(events))})()`);\nawait send('Page.navigate', { url: BASE });\nawait waitFor(`document.getElementById('generate-button')&&!document.getElementById('generate-button').disabled`);\nawait sleep(800);\nawait js(CURSOR);\nawait js(`window.__cursor.move(900,300,10)`);\nawait sleep(700);\nconst demo2Start = now();\n\"\"\")\nrep(\"await mark('10-diary', '#diary-period + .bmw-select .bmw-select-trigger');\",\"await mark('10-diary', '#diary-period + .bmw-select .bmw-select-trigger', { start: demo2Start });\")\nopen(p,'w').write(s)\n\np='walkthrough/tools/encode.mjs'; s=open(p).read()\na=\"  const segmentEnd = trimmed(step.end);\"\nassert s.count(a)==1\ns=s.replace(a,\"  if (step.start) segmentStart = trimmed(step.start);\\n  const segmentEnd = trimmed(step.end);\")\nopen(p,'w').write(s)\n\np='walkthrough/tools/rec.sh'; s=open(p).read()\na='$WORK/rec \"$REPO/demo-data\"'\nassert s.count(a)==1\ns=s.replace(a,'$WORK/rec \"$REPO/demo-data\" \"$WORK/app/data\"')\nopen(p,'w').write(s)\n\np='walkthrough/tools/build.mjs'; s=open(p).read()\na=\"<p class=\\\"kicker-line\\\">Demo 2</p><h2 class=\\\"display\\\">A handover.<br>The new PM starts with the memory, not from zero.</h2>\"\nassert s.count(a)==1\ns=s.replace(a,\"<p class=\\\"kicker-line\\\">Demo 2 · Six months later</p><h2 class=\\\"display\\\">A handover.<br>The new PM starts with the memory, not from zero.</h2>\")\na=\"'08-approve': { chapter: 'demo1', title: 'One sentence on why', text: 'The reason is saved with the decision in Decision Memory.'\"\nassert s.count(a)==1\ns=s.replace(a,\"'08-approve': { chapter: 'demo1', title: 'Say why, out loud', text: 'The PM dictates the reason; it is transcribed live and saved with the decision in Decision Memory.'\")\na=\"'10-diary': { chapter: 'demo2', title: 'A new PM joins the project', text: 'Day one: the Project Diary shows every change and decision on this vehicle, day by day.'\"\nassert s.count(a)==1\ns=s.replace(a,\"'10-diary': { chapter: 'demo2', title: 'October: a new PM joins the project', text: 'Day one: the Project Diary shows every change and decision on this vehicle, including the April decisions of the previous PM.'\")\nopen(p,'w').write(s)\nEOF\nnode --check walkthrough/tools/record.mjs && node --check walkthrough/tools/encode.mjs && node --c