cumentElement.scrollHeight-innerHeight,scrollY+el.getBoundingClientRect().top-${offset}));if(Math.abs(to-from)<4)return;const s=performance.now();return new Promise(res=>{const f=n=>{const p=Math.min(1,(n-s)/${ms}),e=p<.5?4*p*p*p:1-Math.pow(-2*p+2,3)/2;scrollTo(0,from+(to-from)*e);p<1?requestAnimationFrame(f):res()};requestAnimationFrame(f)})})()`);","+  await js(`(()=>{const el=document.querySelector(${JSON.stringify(selector)});const from=scrollY,to=Math.max(0,Math.min(document.documentElement.scrollHeight-innerHeight,scrollY+el.getBoundingClientRect().top-${offset}));if(Math.abs(to-from)<4)return;const s=performance.now();return new Promise(res=>{const f=n=>{const p=Math.min(1,(n-s)/${ms}),e=p<.5?4*p*p*p:1-Math.pow(-2*p+2,3)/2;scrollTo({top:from+(to-from)*e,behavior:'instant'});p<1?requestAnimationFrame(f):res()};requestAnimationFrame(f)})})()`);","   await sleep(250);"," }"," async function typeInto(selector, text, delay = 16) {"]},{"oldStart":219,"oldLines":7,"newStart":219,"newLines":7,"lines":[" "," // Demo 2"," await click('#new-feature-button');","-await js(`window.scrollTo(0,0)`);","+await js(`window.scrollTo({top:0,behavior:'instant'})`);"," await sleep(900);"," await mark('10-diary', '#diary-period + .bmw-select .bmw-select-trigger');"," "]}]}],"moreFiles":0,"changedFiles":["/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL/walkthrough/tools/record.mjs"]}},"serverClassifierContext":{"request":"c6ec4c29-5b3c-4b4c-b9f0-7b52624aee1a","context":{"git_state":{"cwd":"/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL","root":"/Users/abdulrafaymohammed/Documents/Privat/Hackathons/EHL Final/Final-Hack-EHL","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":11,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"max-gsnr/Final-Hack-EHL","visibility":"unknown"},"push_remote":"origin","remo